// Schema dựng lại từ các truy vấn/kiểu dữ liệu mà code frontend + API đang dùng.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Kết nối qua pool cho app; kết nối trực tiếp cho lệnh prisma (db push, seed).
  // Tên biến trùng với biến mà Neon tự tạo khi kết nối với Vercel.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  USER
  ADMIN
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum QuizType {
  MULTIPLE_CHOICE
  FILL_IN_BLANK
  /// Nghe (audioUrl hoặc giọng máy đọc audioText) rồi chọn/viết đáp án
  LISTENING
  /// Nói (micro) hoặc viết lại câu
  SPEAKING
  /// Sắp xếp các thẻ từ (options) thành câu đúng
  WORD_ORDER
}

/// Các trò chơi trong trang Luyện tập
enum PracticeMode {
  MATCH
  SPEED
  DICTATION
  SENTENCE
  PRONUNCIATION
}

enum ActivityType {
  LESSON
  PRACTICE
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ---------------------------------------------------------------------------
// User + các bảng NextAuth (PrismaAdapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// null: tài khoản tạo bằng Google, chưa đặt mật khẩu
  passwordHash  String?
  role          Role      @default(USER)
  xp            Int       @default(0)
  streak        Int       @default(0)
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  progress   UserProgress[]
  activities Activity[]
  reviews    WordReview[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Nội dung học
// ---------------------------------------------------------------------------

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  level       Level    @default(BEGINNER)
  imageUrl    String?
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units Unit[]
}

model Unit {
  id       String @id @default(cuid())
  title    String
  order    Int
  courseId String

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, order])
}

model Lesson {
  id       String @id @default(cuid())
  title    String
  order    Int
  xpReward Int    @default(10)
  /// Ghi chú ngữ pháp của bài (xem GrammarNote trong types/api.ts); null = bài không có
  grammarNote Json?
  /// Đoạn hội thoại tình huống mở đầu bài (xem LessonStory trong types/api.ts); null = bài không có
  story       Json?
  unitId   String

  unit         Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  vocabularies Vocabulary[]
  exercises    Exercise[]
  progress     UserProgress[]

  @@index([unitId, order])
}

model Vocabulary {
  id              String  @id @default(cuid())
  word            String
  phonetic        String?
  meaning         String
  exampleSentence String?
  /// Bản dịch tiếng Việt của câu ví dụ
  exampleTranslation String?
  audioUrl        String?
  /// Cấp độ CEFR (A1, A2...) với từ thuộc bộ từ vựng chuẩn: dùng để luyện tập theo bộ từ
  cefr            String?
  order           Int     @default(0)
  lessonId        String

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, order])
  @@index([cefr])
}

model Exercise {
  id            String   @id @default(cuid())
  question      String
  type          QuizType
  /// Mảng chuỗi các lựa chọn; null với câu tự điền
  options       Json?
  correctAnswer String
  explanation   String?
  audioUrl      String?
  /// Câu cho giọng máy đọc (TTS) khi không có audioUrl, dùng cho bài nghe
  audioText     String?
  order         Int
  lessonId      String

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, order])
}

model UserProgress {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  status      ProgressStatus @default(NOT_STARTED)
  /// Điểm cao nhất, 0-100
  score       Int?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// ---------------------------------------------------------------------------
// Hoạt động học có tính XP (bảng xếp hạng tuần, giới hạn XP luyện tập mỗi ngày, kỷ lục)
// ---------------------------------------------------------------------------

/// 1 dòng = hoàn thành 1 bài lần đầu (LESSON) hoặc 1 lượt luyện tập (PRACTICE, có thể 0 XP khi đã chạm giới hạn ngày)
model Activity {
  id        String        @id @default(cuid())
  userId    String
  type      ActivityType
  xpEarned  Int           @default(0)
  /// Chỉ có với PRACTICE
  mode      PracticeMode?
  /// PRACTICE: điểm của lượt (để tính kỷ lục). LESSON: điểm lần nộp bài (0-100)
  score     Int?
  /// Chỉ có với LESSON
  lessonId  String?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Người học tự đánh giá mức nhớ 1 từ: 1 = Chưa nhớ, 2 = Hơi nhớ, 3 = Đã nhớ.
/// Lưu theo chữ của từ (viết thường) chứ không theo id: 1 từ có thể nằm ở nhiều bài/khóa,
/// và seed có thể tạo lại dòng Vocabulary khi cập nhật nội dung.
/// Mức nhớ tự đánh giá và lịch ôn (lặp lại ngắt quãng) của 1 từ, theo từng user
model WordReview {
  id           String    @id @default(cuid())
  userId       String
  /// Từ viết thường (xem wordKey trong lib/word-rating.ts)
  word         String
  /// 1 Chưa nhớ, 2 Hơi nhớ, 3 Đã nhớ; null = chưa tự đánh giá (từ chỉ có lịch ôn)
  rating       Int?
  /// Khoảng cách của lần ôn hiện tại (ngày): 1, 3, 7, 14, 30, 60
  intervalDays Int       @default(0)
  /// Đến hạn ôn từ thời điểm này (0:00 giờ Việt Nam); null = chưa lên lịch
  dueAt        DateTime?
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
  @@index([userId, dueAt])
}

// ---------------------------------------------------------------------------
// Xem phim: phụ đề song ngữ của các clip YouTube trong lib/videos/catalog.ts
// ---------------------------------------------------------------------------

/// Phụ đề của 1 clip, do ADMIN căn thời gian ở trang /videos/<slug>/studio
model VideoSubtitle {
  /// slug của clip trong lib/videos/catalog.ts
  clipSlug    String   @id
  /// Mảng câu thoại: SubtitleLine[] (xem types/video.ts); câu có start = null là chưa căn
  lines       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}
